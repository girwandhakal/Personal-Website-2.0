# Groq API Key (Required for actual LLM completions, fallback mocks used in development)
GROQ_API_KEY=your_groq_api_key_here

# Cryptographic salt for secure GDPR-compliant IP hashing
IP_SALT=any_random_string_here_for_ip_hashing_salt

# Shared secret Vercel Cron sends to /api/keepalive (daily ping that keeps the free Supabase project from pausing)
CRON_SECRET=any_long_random_string

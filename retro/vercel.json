{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/((?!api(?:/|$)).*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    }
  ],
  "functions": {
    "api/contact.mjs": { "maxDuration": 15 },
    "api/chat.mjs": {
      "maxDuration": 30,
      "includeFiles": "{index.html,education.html,experience.html,projects.html,projects/*.html}"
    }
  }
}
